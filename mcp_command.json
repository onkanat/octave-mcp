{
  "mcpServers": {
    "playwright": {
      "command": "npx",
      "args": [
        "@playwright/mcp@latest"
      ]
    },
    "octave_execute": {
      "#note": "Portable config: prefer the console-script `octave-mcp` installed by pip. If LM Studio can't find it, run scripts/generate_mcp_command.py to produce an absolute-path JSON.",
      "command": "octave-mcp",
      "args": [],
      "env": {
        "PYTHONUNBUFFERED": "1",
        "PATH": "/opt/homebrew/bin:/usr/local/bin:${PATH}",
        "MCP_RUNS_ROOT": "runs",
        "TMPDIR": "runs",
        "OCTAVE_RUNNER_MODE": "octave",
        "MCP_IS_VISION_MODEL": "false",
        "MCP_RATE_LIMIT_MAX": "100",
        "MCP_RATE_LIMIT_WINDOW": "60",
        "MCP_MAX_OUTPUT_CHARS": "20000",
        "MCP_TIMEOUT_SECONDS": "10",
        "MCP_CPU_LIMIT": "0",
        "MCP_MEMORY_MB": "0",
        "MCP_RUNS_RETENTION_DAYS": "0",
        "MCP_ALLOW_FORCE_DELETE": "true"
      }
    }
  }
}
